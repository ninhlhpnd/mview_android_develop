<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:layout_margin="10dp"
    android:background="@drawable/bluetoothdialog_custom"
    android:orientation="vertical"
    android:weightSum="10">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1"
        android:background="@color/xanhduongnhat"
        android:gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/giao_dien_ket_noi_cam_bien"
            android:textColor="@color/black"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginBottom="2dp"
        android:layout_weight="9"
        android:background="@color/xam"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bac"
            android:text="@string/cac_thiet_bi_duoc_ket_noi"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <ListView
            android:id="@+id/listviewTbdaketnoi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#fff"
            android:divider="@color/xanhduongnhat"
            android:dividerHeight="1.0dp"
            android:minHeight="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@color/bac"
                    android:text="@string/chon_mot_thiet_bi_khong_day_de_ket_noi"
                    android:textColor="@color/black"
                    android:textSize="12sp" />

                <ProgressBar
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="right"
                    android:layout_margin="5dp" />
            </FrameLayout>

        </LinearLayout>

        <ListView
            android:id="@+id/listviewTbcotheketnoi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#fff"
            android:divider="@color/xanhduongnhat"
            android:dividerHeight="1.0dp"
            android:minHeight="20dp" />
    </LinearLayout>

</LinearLayout>